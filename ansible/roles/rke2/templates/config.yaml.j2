---
{% if rke2_server is defined %}
server: "{{ rke2_server }}"
{% endif %}
token: "{{ rke2_token }}"
cni: "{{ rke2_cni }}"
node-ip: "{{ ansible_host }}"

{% if rke2_node_taints | default([]) | length > 0 %}
node-taint:
{% for taint in rke2_node_taints %}
  - "{{ taint }}"
{% endfor %}
{% endif %}

tls-san:
{% for san in rke2_tls_sans %}
  - "{{ san }}"
{% endfor %}

write-kubeconfig-mode: "0600"
