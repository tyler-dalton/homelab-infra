vrrp_instance {{ olympus_vrrp_instance_name }} {
    state BACKUP
    interface {{ olympus_vip_interface }}
    virtual_router_id {{ olympus_vrrp_router_id }}
    priority {{ olympus_vrrp_priorities[inventory_hostname] }}
    advert_int {{ olympus_vrrp_advert_interval }}

    authentication {
        auth_type PASS
        auth_pass {{ olympus_vrrp_auth_password }}
    }

    unicast_src_ip {{ ansible_host }}

    unicast_peer {
{% for peer in groups['rke2_servers'] if peer != inventory_hostname %}
        {{ hostvars[peer].ansible_host }}
{% endfor %}
    }

    virtual_ipaddress {
        {{ olympus_api_vip }}/{{ olympus_api_prefix_length }} dev {{ olympus_vip_interface }}
    }
}
